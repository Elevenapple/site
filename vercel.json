{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.paprikaf.com"
        }
      ],
      "destination": "https://paprikaf.com/:path*",
      "permanent": true
    }
  ],
  "functions": {
    "api/fit.ts": {
      "maxDuration": 25,
      "supportsCancellation": true
    },
    "api/mcp.ts": {
      "maxDuration": 30
    },
    "api/role-source.ts": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/resume",
      "destination": "/index.html"
    },
    {
      "source": "/writing",
      "destination": "/index.html"
    },
    {
      "source": "/writing/:path*",
      "destination": "/index.html"
    }
  ]
}
